# Copy this file to .env and fill in your own values.
# Get the Client ID from https://developer.spotify.com/dashboard -> your app
# -> Settings. Then run once:  .venv/bin/python -m spotify_nicotine auth
SPOTIFY_CLIENT_ID=

# NOT needed for the normal browser-authorization flow. Only set this if you
# have an old (pre-2025) app whose app-only tokens can still read playlists:
# SPOTIFY_CLIENT_SECRET=

# Only needed if your Spotify app registers a different redirect URI:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Only needed if you set an api_token in the Nicotine+ plugin settings:
# NICOTINE_API_TOKEN=

# Only needed if the plugin listens somewhere else:
# SPOTIFY_NICOTINE_API_URL=http://127.0.0.1:12339
